{
  "name": "qdis-korea-guide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.netlify.config.ts",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "vite build --config vite.netlify.config.ts",
    "build:ssr": "vite build --config vite.netlify.config.ts --ssr entry-server.tsx --outDir ../dist-ssr",
    "typecheck": "tsc --noEmit",
    "sync:meals": "node scripts/sync/meals.mjs",
    "monitor:boards": "node scripts/sync/boards.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
